# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobagent

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption ──────────────────────────────────────────────────────────────
ENCRYPTION_KEY=                    # 32-byte base64 string

# ─── App ─────────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_URL=http://localhost:3000
NODE_ENV=development
ALLOW_SIGNUP=false

# ─── Seed: Super Admin ────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=              # Used by seed only; change after first login

# ─── LLM ─────────────────────────────────────────────────────────────────────
LLM_CHAIN=gemini,groq              # Ordered fallback chain
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434   # Optional; off by default
LLM_DAILY_CALL_BUDGET=300

# ─── Telegram (Sprint 2) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── Email Ingestion (Sprint 2) ──────────────────────────────────────────────
JOBALERTS_IMAP_HOST=imap.gmail.com
JOBALERTS_IMAP_USER=
JOBALERTS_IMAP_APP_PASSWORD=

# ─── Google Places (Sprint 4) ────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=             # Restrict by API; set quota + budget alert
