// AI Job & Client Agent — Sprint 0 Schema
// Prisma 7 · PostgreSQL (pgvector/pgvector:pg16)
// Extend with pgvector in a separate --create-only migration when needed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Sprint 0: Foundation ────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  USER
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  SETTING_UPDATE
  RECORD_CREATE
  RECORD_UPDATE
  RECORD_DELETE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String?
  entityId  String?
  meta      Json?
  requestId String?
  ipAddress String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
