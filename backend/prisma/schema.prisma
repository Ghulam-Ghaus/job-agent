// AI Job & Client Agent — Sprint 0 + Sprint 1 Schema
// Prisma 7 · PostgreSQL (pgvector/pgvector:pg16)
// pgvector extension is enabled via a separate --create-only migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  USER
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  SETTING_UPDATE
  RECORD_CREATE
  RECORD_UPDATE
  RECORD_DELETE
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum OpportunityType {
  JOB
  FREELANCE
  LEAD
}

enum OpportunityStatus {
  DISCOVERED
  QUALIFIED
  DRAFT_READY
  AWAITING_APPROVAL
  APPLIED
  VIEWED
  SHORTLISTED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  CLOSED
  FILTERED_OUT
}

enum LlmProvider {
  GEMINI
  GROQ
  OLLAMA
}

// ─── Sprint 0: Foundation ────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  role              Role      @default(USER)
  isActive          Boolean   @default(true)
  slug              String?   @unique
  twoFactorSecret   String?
  twoFactorEnabled  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]

  // Sprint 1 relations
  profile       Profile?
  experiences   Experience[]
  skills        Skill[]
  projects      Project[]
  cvs           Cv[]
  answerBank    AnswerBankItem[]
  preferences   JobPreference?
  opportunities    Opportunity[]
  llmCalls         LlmCall[]
  notifications    Notification[]
  applyPacks       ApplyPack[]
  approvalRecords  ApprovalRecord[]
  companies        Company[]
  outreachMessages OutreachMessage[]
  suppressions     SuppressionEntry[]
  products         Product[]

  // Sprint 6 relations
  tailoredCvs      TailoredCv[]
  coverLetters     CoverLetter[]
  interviewPreps   InterviewPrep[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String?
  entityId  String?
  meta      Json?
  requestId String?
  ipAddress String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── Sprint 1: Profile ───────────────────────────────────────────────────────

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  fullName            String?
  headline            String?
  summary             String?
  phone               String?
  location            String?
  country             String?
  linkedinUrl         String?
  githubUrl           String?
  portfolioUrl        String?
  languages           Json     @default("[]") // [{ language, level }]
  visaStatus          String?
  noticePeriodDays    Int?
  willingToRelocate   Boolean  @default(false)
  relocationCountries Json     @default("[]") // string[]
  telegramChatId      String?
  onboardingDone      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Experience {
  id        String    @id @default(cuid())
  userId    String
  title     String
  company   String
  location  String?
  country   String?
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  bullets   Json      @default("[]") // string[]
  techStack Json      @default("[]") // string[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("experiences")
}

model Skill {
  id         String     @id @default(cuid())
  userId     String
  name       String
  level      SkillLevel @default(INTERMEDIATE)
  yearsOfExp Float?
  category   String? // e.g. "Backend", "DevOps", "Language"
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("skills")
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  techStack   Json      @default("[]") // string[]
  url         String?
  repoUrl     String?
  highlights  Json      @default("[]") // string[]
  tags        Json      @default("[]") // string[]
  isPublic    Boolean   @default(true)
  featured    Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("projects")
}

model Cv {
  id          String   @id @default(cuid())
  userId      String
  label       String // e.g. "Backend NodeJS", "Full Stack"
  filename    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  tags        Json     @default("[]") // string[]
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityMatches OpportunityMatch[]

  @@index([userId])
  @@map("cvs")
}

model AnswerBankItem {
  id        String   @id @default(cuid())
  userId    String
  question  String
  answer    String
  tags      Json     @default("[]") // string[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("answer_bank_items")
}

model JobPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  targetRoles         Json     @default("[]") // string[]
  targetCountries     Json     @default("[]") // string[]
  minSalaryUsd        Int?
  remoteOk            Boolean  @default(true)
  blacklistCompanies  Json     @default("[]") // string[]
  blacklistKeywords   Json     @default("[]") // string[]
  preferredIndustries Json     @default("[]") // string[]
  scoreWeights        Json? // override default weights from Setting
  atsTargets          Json     @default("[]") // [{ platform: "greenhouse"|"lever", slug }]
  locationFilters     Json     @default("[]") // string[] e.g. ["Saudi Arabia","Dubai","Remote"]
  cvStyle             String   @default("AUTO") // AUTO | GULF | EUROPE
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("job_preferences")
}

// ─── Sprint 1: Opportunities ─────────────────────────────────────────────────

model Opportunity {
  id          String            @id @default(cuid())
  userId      String
  type        OpportunityType   @default(JOB)
  status      OpportunityStatus @default(DISCOVERED)
  contentHash String
  fingerprint String?
  sourceType  String? // EMAIL | ATS | MANUAL | PLACES
  sourceRef   String? // e.g. email message-id or ATS job id
  title       String?
  company     String?
  country     String?
  city        String?
  url         String?
  rawText     String
  language    String?           @default("en")
  postedAt    DateTime?
  filterReason        String?
  filterFlags         Json?             @default("[]")
  scoreAdjustments    Json?             @default("[]")
  outreachStatus      String?           @default("not_sent")
  outreachSentAt      DateTime?
  outreachFollowUpDue DateTime?
  outreachPack        Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirement OpportunityRequirement?
  match       OpportunityMatch?
  applyPack   ApplyPack?

  // Sprint 6
  tailoredCvs    TailoredCv[]
  coverLetters   CoverLetter[]
  interviewPreps InterviewPrep[]

  @@unique([userId, contentHash])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, type])
  @@map("opportunities")
}

model OpportunityRequirement {
  id            String   @id @default(cuid())
  opportunityId String   @unique
  fieldsJson    Json // { title, company, skills[], yearsExp, seniority, salary, visa, remote, ... }
  evidenceJson  Json // { fieldName: "quoted text from rawText" }
  promptVersion String
  model         String
  extractedAt   DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("opportunity_requirements")
}

model OpportunityMatch {
  id              String   @id @default(cuid())
  opportunityId   String   @unique
  score           Int // 0–100
  breakdownJson   Json // { technical, experience, location, seniority, salary, visa, industry, other }
  gapsJson        Json     @default("[]") // [{ field, reason }]
  recommendedCvId String?
  scoredAt        DateTime @default(now())

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  recommendedCv Cv?         @relation(fields: [recommendedCvId], references: [id], onDelete: SetNull)

  @@map("opportunity_matches")
}

// ─── Sprint 1: LLM Audit + Notifications ─────────────────────────────────────

model LlmCall {
  id         String      @id @default(cuid())
  userId     String?
  provider   LlmProvider
  model      String
  promptHash String // sha256 of prompt — cache key
  cached     Boolean     @default(false)
  tokensIn   Int?
  tokensOut  Int?
  costUsd    Float?
  durationMs Int?
  purpose    String? // extraction | scoring_explanation | proposal
  status     String      @default("ok") // ok | error | needs_review
  errorMsg   String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([promptHash])
  @@index([createdAt])
  @@map("llm_calls")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ─── Sprint 2: Apply Packs & Approval ─────────────────────────────────────────

model ApplyPack {
  id              String   @id @default(cuid())
  opportunityId   String   @unique
  userId          String
  coverNote       String   // AI-generated tailored cover letter
  coverNoteEdited String?  // User's edited version (if any)
  selectedCvId    String?
  answersFilled   Json     @default("[]") // [{ question, answer }]
  verifierStatus  String   @default("pending") // pending | passed | flagged
  verifierIssues  Json     @default("[]") // [{ claim, reason }]
  promptVersion   String   @default("v1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  approval    ApprovalRecord?

  @@index([userId])
  @@index([verifierStatus])
  @@map("apply_packs")
}

model ApprovalRecord {
  id          String   @id @default(cuid())
  applyPackId String   @unique
  userId      String
  decision    String   // approved | rejected
  notes       String?  // Optional reviewer notes
  decidedAt   DateTime @default(now())

  applyPack ApplyPack @relation(fields: [applyPackId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("approval_records")
}

// ─── Sprint 4: Direct Clients & Leads ─────────────────────────────────────────

enum LeadStatus {
  RESEARCHING
  QUALIFIED
  DRAFT_READY
  CONTACTED
  REPLIED
  MEETING
  PROPOSAL_SENT
  WON
  LOST
  NOT_INTERESTED
}

enum OutreachStatus {
  DRAFT
  APPROVED
  SENT
  REJECTED
}

model Company {
  id                 String      @id @default(cuid())
  userId             String
  name               String
  placeId            String?     // Google Places ID
  website            String?
  phone              String?
  address            String?
  city               String?
  country            String?
  businessType       String?     // e.g. "dental_clinic", "accounting", "logistics"
  status             LeadStatus  @default(RESEARCHING)
  qualificationScore Int?        // 0–100 based on need signals
  needSignalsJson    Json        @default("[]") // [{ signal: string, evidence: string, severity: 'HIGH'|'MED'|'LOW' }]
  notes              String?
  lastContactedAt    DateTime?
  nextFollowUpAt     DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts           Contact[]
  outreachMessages   OutreachMessage[]

  @@unique([userId, placeId])
  @@index([userId])
  @@index([userId, status])
  @@map("companies")
}

model Contact {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  role        String?  // e.g. "Founder", "Managing Partner", "Operations Director"
  email       String?
  phone       String?
  linkedinUrl String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  outreachMessages OutreachMessage[]

  @@index([companyId])
  @@map("contacts")
}

model OutreachMessage {
  id          String         @id @default(cuid())
  companyId   String
  contactId   String?
  userId      String
  channel     String         @default("EMAIL")
  subject     String
  body        String
  status      OutreachStatus @default(DRAFT)
  sentAt      DateTime?
  openedAt    DateTime?
  repliedAt   DateTime?
  approvalId  String?
  optOutToken String         @unique @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@map("outreach_messages")
}

model SuppressionEntry {
  id        String   @id @default(cuid())
  userId    String
  domain    String?  // e.g. "competitor.com" or opted-out business domain
  email     String?  // e.g. "ceo@company.com"
  reason    String   // e.g. "opt_out", "competitor", "bounced", "manual"
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId])
  @@map("suppression_entries")
}

// ─── Sprint 5: Productized Offerings & Showcase ───────────────────────────────

model Product {
  id          String   @id @default(cuid())
  userId      String
  slug        String   @unique
  title       String
  tagline     String?
  description String
  category    String   @default("AI_AUTOMATION") // AI_AUTOMATION | FULLSTACK_APP | AGENT_PIPELINE
  features    Json     @default("[]") // string[]
  priceUsd    Int?
  priceModel  String   @default("FIXED") // FIXED | HOURLY | MONTHLY_RETAINER
  demoUrl     String?
  badge       String?  // e.g. "POPULAR", "NEW", "FEATURED"
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("products")
}

// ─── Sprint 6: Career Assets ─────────────────────────────────────────────────

model TailoredCv {
  id             String   @id @default(cuid())
  userId         String
  opportunityId  String?
  targetRole     String
  inputHash      String   // sha256 of (profile snapshot + JD) — cache key
  contentJson    Json     // { headline, summary, skills[], experiences[{title,company,period,bullets[]}], projects[] }
  verifierStatus String   @default("pending") // pending | passed | flagged
  verifierIssues Json     @default("[]") // [{ claim, reason }]
  promptVersion  String   @default("v1")
  createdAt      DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, opportunityId])
  @@index([inputHash])
  @@map("tailored_cvs")
}

model CoverLetter {
  id             String   @id @default(cuid())
  userId         String
  opportunityId  String
  inputHash      String
  body           String
  bodyEdited     String?
  verifierStatus String   @default("pending")
  verifierIssues Json     @default("[]")
  promptVersion  String   @default("v1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, opportunityId])
  @@index([inputHash])
  @@map("cover_letters")
}

model InterviewPrep {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String?
  targetRole    String
  inputHash     String
  planJson      Json     // { overview, topics[], questions[], gapBridges[], questionsToAsk[] }
  tasksJson     Json     @default("[]") // [{ id, title, description, topic, difficulty, done }]
  promptVersion String   @default("v1")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, opportunityId])
  @@index([inputHash])
  @@map("interview_preps")
}
